import haxe.ds.StringMap;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
// socket
import suil0304.socket.DatagramSocket;
// socket.event
import suil0304.socket.event.SocketEventType;

// + dont use it
class SuilUDPSocketManager extends Module {
    // enum shit
    public var CONNECT(get, never):Int;

    function get_CONNECT():Int {
        return SocketEventType.CONNECT;
    }

    public var DATA(get, never):Int;

    function get_DATA():Int {
        return SocketEventType.DATA;
    }

    public var CLOSE(get, never):Int;

    function get_CLOSE():Int {
        return SocketEventType.CLOSE;
    }

    // socket manager
    private var __socketMap:StringMap<DatagramSocket>;

    public function new() {
        super("suil-udp-socket-manager", 2);
    }

    override function onCreate(event:ScriptEvent) {
        __socketMap = new StringMap();
    }

    public function createSocket(id:String):Bool {
        if(__socketMap.exists(id)) {
            return false;
        }

        var socket = new DatagramSocket();
        __socketMap.set(id, socket);

        return true;
    }

    public function bindSocket(id:String, localPort:Int = 0, localAddress:String = "0.0.0.0"):Bool {
        if(!__socketMap.exists(id)) {
            return false;
        }

        var socket = __socketMap.get(id);
        socket.bind(localPort, localAddress);

        return true;
    }

    // public function connectSocket(id:String, host:String, port:Int):Bool {
    //     if(!__socketMap.exists(id)) {
    //         return false;
    //     }

    //     var socket = __socketMap.get(id);
    //     if(socket.connected) {
    //         return false;
    //     }

    //     socket.connect(host, port);

    //     return true;
    // }

    public function closeSocket(id:String):Bool {
        if(!__socketMap.exists(id)) {
            return false;
        }

        var socket = __socketMap.get(id);
        socket.close();
        __socketMap.remove(id);

        return true;
    }

    public function send(id:String, text:String, address:Null<String> = null, port:Int = 0):Bool {
        if(!__socketMap.exists(id)) {
            return false;
        }

        var socket = __socketMap.get(id);
        socket.send(text, address, port);

        return true;
    }

    public function receive(id:String):Bool {
        if(!__socketMap.exists(id)) {
            return false;
        }

        var socket = __socketMap.get(id);
        socket.receive();

        return true;
    }

    // sad typing aw
    public function addEventListener(id:String, socketEvent:Int, listener:Dynamic->Void, priority:Int = 10):Bool {
        if(!__socketMap.exists(id)) {
            return false;
        }

        var socket = __socketMap.get(id);

        socket.addEventListener(socketEvent, listener, priority);

        return true;
    }

    // aw aw
    public function removeEventListener(id:String, socketEvent:Int, listener:Dynamic->Void):Bool {
        if(!__socketMap.exists(id)) {
            return false;
        }

        var socket = __socketMap.get(id);

        return socket.removeEventListener(socketEvent, listener);
    }

    public function willTrigger(id:String, socketEvent:Int):Bool {
        if(!__socketMap.exists(id)) {
            return false;
        }

        var socket = __socketMap.get(id);

        return socket.willTrigger(socketEvent);
    }

    // override function onUpdate(event:UpdateScriptEvent) {
    //     for(id => socket in __socketMap.keyValueIterator()) {
    //         socket.update(event.elapsed);
    //     }
    // }

    override function onDestroy(event:ScriptEvent) {
        var ids:Array<String> = [];

        for(id in __socketMap.keys()) {
            ids.push(id);

            try {
                __socketMap.get(id).close();
            }
            catch(e:Dynamic) {}
        }

        for(id in ids) {
            __socketMap.remove(id);
        }

        ids = null;
    }
}
