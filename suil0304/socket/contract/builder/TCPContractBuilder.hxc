package suil0304.socket.contract.builder;

import haxe.ds.StringMap;
import suil0304.socket.contract.TCPCustomContract;
import suil0304.socket.contract.header.TCPFirstFrameHeader;
import suil0304.socket.contract.header.TCPHeader;

// i love builder pattern
// yay
class TCPContractBuilder {
    // timeout
    private var __connectTimeout:Int = 0; // ms
    private var __refreshTimeout:Int = 0; // ms

    // header
    private var __firstFrameHeader:TCPFirstFrameHeader;
    private var __header:TCPHeader;

    // handshake
    private var __connectedMessage:Null<String>;
    private var __closeMessage:Null<String>;

    // option
    private var __doBytePadding:Bool;
    private var __doBytePaddingFrameEnd:Bool;

    public function new() {
        __doBytePadding = false;
        __doBytePaddingFrameEnd = false;
    }

    // contract
    public function setConnectTimeout(ms:Int):TCPContractBuilder {
        if(ms <= 0) {
            throw "invalid timeout";
        }
        __connectTimeout = ms;
        return this;
    }

    public function setRefreshTimeout(ms:Int):TCPContractBuilder {
        if(ms <= 0) {
            throw "invalid timeout";
        }
        __refreshTimeout = ms;
        return this;
    }

    // header
    public function setFirstFrameHeader(builderFunc:TCPFirstFrameHeaderBuilder->TCPFirstFrameHeader):TCPContractBuilder {
        __firstFrameHeader = builderFunc(new TCPFirstFrameHeaderBuilder());

        return this;
    }

    public function setHeader(buildFunc:TCPHeaderBuilder->TCPHeader):TCPContractBuilder {
        __header = buildFunc(new TCPHeaderBuilder());

        return this;
    }

    // handshake
    public function setConnectedMessage(message:String):TCPContractBuilder {
        if(message == null) {
            throw "invalid message";
        }
        __connectedMessage = message;
        return this;
    }

    public function setCloseMessage(message:String):TCPContractBuilder {
        if(message == null) {
            throw "invalid message";
        }
        __closeMessage = message;
        return this;
    }

    // option
    public function setDoBytePadding(v:Bool):TCPContractBuilder {
        __doBytePadding = v;

        return this;
    }

    public function setDoBytePaddingFrameEnd(v:Bool):TCPContractBuilder {
        __doBytePaddingFrameEnd = v;

        return this;
    }

    public function build():TCPCustomContract {
        if(__header == null || __firstFrameHeader == null) {
            throw "no header";
        }

        if(__connectTimeout == 0) {
            throw "zero ms to timeout is not support";
        }

        if(__refreshTimeout == 0) {
            throw "zero ms to timeout is not support";
        }

        if(__connectedMessage == null) {
            throw "invalid connected message";
        }

        if(__closeMessage == null) {
            throw "invalid close message";
        }

        var totalHeaderSize = 0;
        var totalHeaderByteSize = 0;

        var totalFirstFrameHeaderSize = 0;
        var totalFirstFrameHeaderByteSize = 0;

        if(__doBytePadding) {
            for(header in __header.headerMap.iterator()) {
                var size = header.size;
                var remain = (size % 8);

                if(remain != 0) {
                    size += 8 - remain;
                }

                totalHeaderSize += size;
            }
            totalHeaderByteSize = Std.int(totalHeaderSize / 8);

            for(header in __firstFrameHeader.headerMap.iterator()) {
                var size = header.size;
                var remain = (size % 8);

                if(remain != 0) {
                    size += 8 - remain;
                }

                totalFirstFrameHeaderSize += size;
            }
            totalFirstFrameHeaderByteSize = Std.int(totalFirstFrameHeaderSize / 8);
        }
        else {
            totalHeaderSize = __header.totalSize;
            totalHeaderByteSize = __header.totalByteSize;

            totalFirstFrameHeaderSize = __firstFrameHeader.totalSize;
            totalFirstFrameHeaderByteSize = __firstFrameHeader.totalByteSize;
        }

        return new TCPCustomContract(
            {
                connectTimeout: __connectTimeout,
                refreshTimeout: __refreshTimeout
            },
            {
                header: __header,
                firstFrameHeader: __firstFrameHeader,

                totalHeaderSize: totalHeaderSize,
                totalHeaderByteSize: totalHeaderByteSize,

                totalFirstFrameHeaderSize: totalFirstFrameHeaderSize,
                totalFirstFrameHeaderByteSize: totalFirstFrameHeaderByteSize
            },
            {
                connectedMessage: __connectedMessage,
                closeMessage: __closeMessage
            },
            {
                doBytePadding: __doBytePadding,
                doBytePaddingFrameEnd: __doBytePaddingFrameEnd
            }
        );
    }
}
