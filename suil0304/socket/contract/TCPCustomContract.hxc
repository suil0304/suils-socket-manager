package suil0304.socket.contract;

import haxe.ds.StringMap;
import suil0304.ds.ReadonlyStringMap;
import suil0304.ds.ReadonlyArray;
import suil0304.socket.contract.header.TCPHeader;
import suil0304.socket.contract.header.TCPFirstFrameHeader;

class TCPCustomContract {
    // contract
    public var connectTimeout(default, null):Int = 0;
    public var refreshTimeout(default, null):Int = 0;

    // header
    public var header(default, null):TCPHeader;
    public var firstFrameHeader(default, null):TCPFirstFrameHeader;

    public var totalHeaderSize(default, null):Int;
    public var totalHeaderByteSize(default, null):Int;

    public var totalFirstFrameHeaderSize(default, null):Int;
    public var totalFirstFrameHeaderByteSize(default, null):Int;

    // handshake
    public var connectedMessage(default, null):String;
    public var closeMessage(default, null):String;

    // option
    public var doBytePadding(default, null):Bool;
    public var doBytePaddingFrameEnd(default, null):Bool;

    public function new(
        contractParameters:ContractParameters,
        headerParameters:HeaderParameters,
        handshakeParameters:HandshakeParameters,
        optionParameters:OptionParameters
    ) {
        connectTimeout = contractParameters.connectTimeout;
        refreshTimeout = contractParameters.refreshTimeout;

        header = headerParameters.header;
        firstFrameHeader = headerParameters.firstFrameHeader;

        totalHeaderSize = headerParameters.totalHeaderSize;
        totalHeaderByteSize = headerParameters.totalHeaderByteSize;

        totalFirstFrameHeaderSize = headerParameters.totalFirstFrameHeaderSize;
        totalFirstFrameHeaderByteSize = headerParameters.totalFirstFrameHeaderByteSize;

        connectedMessage = new String(handshakeParameters.connectedMessage);
        closeMessage = new String(handshakeParameters.closeMessage);

        doBytePadding = optionParameters.doBytePadding;
        doBytePaddingFrameEnd = optionParameters.doBytePaddingFrameEnd;
    }

    public function getHeaderByIndex(index:Int) {
        return header.getHeaderByIndex(index);
    }

    public function getHeaderByName(name:String) {
        return header.getHeaderByName(name);
    }

    public function getHeaderByUniqueRole(role:Int) {
        return header.getHeaderByUniqueRole(role);
    }

    public function getFirstFrameHeaderByIndex(index:Int) {
        return firstFrameHeader.getHeaderByIndex(index);
    }

    public function getFirstFrameHeaderByName(name:String) {
        return firstFrameHeader.getHeaderByName(name);
    }

    public function getFirstFrameHeaderByUniqueRole(role:Int) {
        return firstFrameHeader.getHeaderByUniqueRole(role);
    }
}

// parameter
typedef ContractParameters = {
    var connectTimeout:Int;
    var refreshTimeout:Int;
}

typedef HeaderParameters = {
    var header:TCPHeader;
    var firstFrameHeader:TCPFirstFrameHeader;

    var totalHeaderSize:Int;
    var totalHeaderByteSize:Int;

    var totalFirstFrameHeaderSize:Int;
    var totalFirstFrameHeaderByteSize:Int;
}

typedef HandshakeParameters = {
    var connectedMessage:String;
    var closeMessage:String;
}

typedef OptionParameters = {
    var doBytePadding:Bool;
    var doBytePaddingFrameEnd:Bool;
}
