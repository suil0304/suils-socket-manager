package suil0304.socket.contract.constants;

import haxe.ds.IntMap;

class TCPHeaderRoleInfo {
    public static final ROLE_INFO:IntMap<RoleInfo> = [
        TCPHeaderRole.NOTHING => {
            unique: false,
            optional: true,
            blacklistedType: []
        },
        TCPHeaderRole.PAYLOAD_BYTE_SIZE => {
            unique: true,
            optional: false,
            blacklistedType: [
                HeaderType.CUSTOM_BIT,
                HeaderType.CUSTOM_BYTE,
                HeaderType.BOOL,
                HeaderType.STRING,
                HeaderType.VARSTRING
            ]
        },
        TCPHeaderRole.FIN => {
            unique: true,
            optional: true,
            blacklistedType: [
                HeaderType.CUSTOM_BIT,
                HeaderType.BYTE,
                HeaderType.SHORT,
                HeaderType.INT,
                HeaderType.LONG,
                HeaderType.CUSTOM_BYTE,
                HeaderType.STRING,
                HeaderType.VARSTRING
            ]
        },
        TCPHeaderRole.MESSAGE_ID => {
            unique: true,
            optional: true,
            blacklistedType: [
                HeaderType.CUSTOM_BIT,
                HeaderType.CUSTOM_BYTE,
                HeaderType.BOOL,
                HeaderType.VARSTRING
            ]
        }
    ];

    private function new() {}
}

typedef RoleInfo = {
    var unique:Bool;
    var optional:Bool;
    var blacklistedType:Array<Int>;
}
