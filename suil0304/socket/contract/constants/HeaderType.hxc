package suil0304.socket.contract.constants;

class HeaderType {
    // bit integer
    public static final CUSTOM_BIT = 0; // fixed(custom bit) size bit

    // byte integer
    public static final BYTE = 1; // 1byte
    public static final SHORT = 2; // 2byte
    public static final INT = 3; // 4byte
    public static final LONG = 4; // 8byte
    public static final CUSTOM_BYTE = 5; // fixed(custom byte) size byte

    // boolean
    public static final BOOL = 6; // 1bit

    // string
    public static final STRING = 7; // fixed(custom byte) size string
    public static final VARSTRING = 8; // variable string

    private function new() {}
}
