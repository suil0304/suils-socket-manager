package suil0304.socket.event.udp;

import suil0304.socket.event.SocketEventBase;
import suil0304.ds.ReadonlyArray;
import suil0304.ds.ReadonlyStringMap;
import openfl.utils.ByteArray;

class UDPSocketDataEvent extends SocketEventBase {
    public var data(default, null):String;

    public function new(localAddress:String, localPort:Int, dataParameters:DataParameters) {
        super(localAddress, localPort);

        data = dataParameters.data.toString();
    }
}

typedef DataParameters = {
    var data:ByteArray;
}
