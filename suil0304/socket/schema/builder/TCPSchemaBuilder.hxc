package suil0304.socket.schema.builder;

import haxe.ds.StringMap;
import suil0304.socket.schema.TCPCustomSchema;
import suil0304.socket.schema.SchemaHeaderType;
import suil0304.socket.schema.SchemaHeaderRole;

// i love builder pattern
// yay
class TCPSchemaBuilder {
    private var __headers:Array<TCPCustomHeaderRaw>;
    private var __connectedMessage:Null<String>;
    private var __closeMessage:Null<String>;

    // builder field
    private var __curHeaderIndex:Int;

    // builder state
    private var __payloadByteSizeExists:Bool;

    public function new() {
        __headers = [];
        __curHeaderIndex = -1;
    }

    private function __validateHeader() {
        if(__headers.length > 0) {
            var header = __headers[__curHeaderIndex];
            if(header.name == null) {
                throw "no header name";
            }
            else if(header.byteSize < 1) {
                throw "invalid header byte size";
            }
        }
    }

    public function addHeader():TCPSchemaBuilder {
        __validateHeader();

        __headers.push({
            name: null,
            type: 0,
            byteSize: 0,
            headerRole: 0;
        });

        __curHeaderIndex = __headers.length - 1;

        return this;
    }

    public function setHeaderIndex(index:Int = 0):TCPSchemaBuilder {
        if(index < 0 || index + 1 > __headers.length) {
            throw "invalid index";
        }

        __validateHeader();

        __curHeaderIndex = index;

        return this;
    }

    public function popHeader():TCPSchemaBuilder {
        if(__headers.length <= 0) {
            throw "no header";
        }

        var header = __headers.pop();
        if(__headers.length > 0) {
            __curHeaderIndex = Std.int(Math.min(__headers.length - 1, __curHeaderIndex));
        }
        else {
            __curHeaderIndex = -1;
        }

        if(header.headerRole & SchemaHeaderRole.PAYLOAD_BYTE_SIZE > 0) {
            __payloadByteSizeExists = false;
        }

        return this;
    }

    public function setHeaderName(name:String):TCPSchemaBuilder {
        if(__headers.length <= 0) {
            throw "no header";
        }

        __headers[__curHeaderIndex].name = name;

        return this;
    }

    public function setHeaderType(type:Int):TCPSchemaBuilder {
        if(__headers.length <= 0) {
            throw "no header";
        }

        var header = __headers[__curHeaderIndex];

        header.byteSize = switch(type) {
            case SchemaHeaderType.BYTE:
                1;

            case SchemaHeaderType.SHORT:
                2;

            case SchemaHeaderType.INT:
                4;

            case SchemaHeaderType.VARINT: // var
                4;

            case SchemaHeaderType.STRING: // var
                20;

            default:
                throw "invalid header type";
        }
        header.type = type;

        return this;
    }

    public function setHeaderByteSize(byteSize:Int):TCPSchemaBuilder {
        if(__headers.length <= 0) {
            throw "no header";
        }

        if(byteSize < 1) {
            throw "invalid header byte size";
        }

        var header = __headers[__curHeaderIndex];

        switch(header.type) {
            case SchemaHeaderType.VARINT, SchemaHeaderType.STRING:

            default:
                throw "changing byte size is not support for this header type";
        }

        header.byteSize = byteSize;

        return this;
    }

    public function addHeaderRole(role:Int):TCPSchemaBuilder {
        if(__headers.length <= 0) {
            throw "no header";
        }

        if(role < 0) {
            throw "invalid role";
        }

        var header = __headers[__curHeaderIndex];

        if(header.headerRole & role > 0) {
            trace("this header already have this role");
        }

        if(
            role == SchemaHeaderRole.PAYLOAD_BYTE_SIZE
            && header.headerRole & SchemaHeaderRole.PAYLOAD_BYTE_SIZE == 0
        ) {
            if(__payloadByteSizeExists) {
                throw "duplicated payload byte size role";
            }
            else {
                __payloadByteSizeExists = true;
            }
        }

        header.headerRole = header.headerRole | role;

        return this;
    }

    public function resetHeaderRole():TCPSchemaBuilder {
        if(__headers.length <= 0) {
            throw "no header";
        }

        var header = __headers[__curHeaderIndex];

        if(header.headerRole & SchemaHeaderRole.PAYLOAD_BYTE_SIZE > 0) {
            __payloadByteSizeExists = false;
        }

        header.headerRole = 0;

        return this;
    }

    public function setConnectedMessage(message:String):TCPSchemaBuilder {
        if(message == null) {
            throw "invalid message";
        }

        __connectedMessage = message;

        return this;
    }

    public function setCloseMessage(message:String):TCPSchemaBuilder {
        if(message == null) {
            throw "invalid message";
        }

        __closeMessage = message;

        return this;
    }

    public function build():TCPCustomSchema {
        if(__headers.length <= 0) {
            throw "no header";
        }

        if(__connectedMessage == null) {
            throw "invalid connected message";
        }

        if(__closeMessage == null) {
            throw "invalid close message";
        }

        if(!__payloadByteSizeExists) {
            throw "no payload byte size header";
        }

        for(i in 0...__headers.length) {
            __curHeaderIndex = i;
            __validateHeader();
        }

        var headerMap = new StringMap<Dynamic>();
        var totalHeaderByteSize = 0;
        var payloadByteSizeHeaderName:String;
        for(i in 0...__headers.length) {
            var header = __headers[i];

            headerMap.set(header.name, {
                type: header.type,
                byteSize: header.byteSize,
                order: i
            });

            totalHeaderByteSize += header.byteSize;

            if(header.headerRole & SchemaHeaderRole.PAYLOAD_BYTE_SIZE > 0) {
                payloadByteSizeHeaderName = header.name;
            }
        }

        return new TCPCustomSchema(
            {
                headerMap: headerMap,
                totalHeaderByteSize: totalHeaderByteSize,
                payloadByteSizeHeaderName: payloadByteSizeHeaderName
            },
            {
                connectedMessage: __connectedMessage,
                closeMessage: __closeMessage
            }
        );
    }
}

typedef TCPCustomHeaderRaw = {
    var name:Null<String>;
    var type:Int; // sick
    var byteSize:Int;

    // role
    var headerRole:Int;
}
