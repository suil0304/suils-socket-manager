package suil0304.socket;

// ds
import haxe.ds.StringMap;
import haxe.ds.IntMap;
import haxe.ds.List;
import suil0304.ds.ReadonlyArray;
import suil0304.ds.ReadonlyStringMap;
// network
import haxe.io.Bytes;
import openfl.net.Socket as OpenFlSocket;
import openfl.utils.ByteArray;
// socket.event.tcp
import suil0304.socket.event.tcp.TCPSocketEventType;
import suil0304.socket.event.tcp.SocketConnectEvent;
import suil0304.socket.event.tcp.SocketDataEvent;
import suil0304.socket.event.tcp.SocketCloseEvent;
import suil0304.socket.event.tcp.SocketTimeoutEvent;
// socket.contract
import suil0304.socket.contract.TCPCustomContract;
import suil0304.socket.contract.constants.HeaderType;

typedef TCPCustomProtocol = {
    var headerMap:StringMap<Dynamic>;
    var payload:ByteArray;
}

class Socket {
    private var __socket:OpenFlSocket;
    private var __events:IntMap<Array<_SocketEventListener>>;

    private var __contract:TCPCustomContract;

    private var __connectTimeoutCount:Float;
    private var __refreshTimeoutCount:Float;

    // buffer
    private var __receiveBuffer:TCPCustomProtocol;
    private var __curReceivePayloadByteSize:Int;

    private var __receivePayloadByteSize(get, never):Null<Int>;

    function get___receivePayloadByteSize():Null<Int> {
        return __receiveBuffer.headerMap.get(__contract.payloadByteSizeHeaderName);
    }

    private var __sendQueue:List<TCPCustomProtocol>;

    // state
    public var receiving(default, null):Bool;
    public var connectCalled(default, null):Bool;
    public var connected(default, null):Bool;
    public var closed(default, null):Bool;
    public var destroyed(default, null):Bool;

    public function new(contract:TCPCustomContract) {
        __socket = new OpenFlSocket();

        __events = new IntMap();

        __events.set(TCPSocketEventType.CONNECT, []);
        __events.set(TCPSocketEventType.DATA, []);
        __events.set(TCPSocketEventType.CLOSE, []);
        __events.set(TCPSocketEventType.CONNECT_TIMEOUT, []);
        __events.set(TCPSocketEventType.REFRESH_TIMEOUT, []);

        __socket.timeout = contract.connectTimeout;

        __contract = contract;

        __receiveBuffer = {
            headerMap: new StringMap(),
            payload: new ByteArray()
        };

        for(name in contract.headerOrderArray.iterator()) {
            __receiveBuffer.headerMap.set(name, null);
        }

        __curReceivePayloadByteSize = 0;

        __sendQueue = new List();

        __connectTimeoutCount = 0;
        __refreshTimeoutCount = 0;

        receiving = false;
        connectCalled = false;
        connected = false;
        closed = true;
        destroyed = false;
    }

    public function update(elapsed:Float) {
        if(closed || destroyed) {
            return;
        }

        __updateReceive(elapsed);
        __updateSend(elapsed);

        if(!connected && connectCalled) {
            if(__connectTimeoutCount > __contract.connectTimeout) {
                dispatchEvent(TCPSocketEventType.CONNECT_TIMEOUT);

                close(false);
            }
            else {
                __connectTimeoutCount += elapsed * 1000;
            }
        }

        if(connected) {
            if(__refreshTimeoutCount > __contract.refreshTimeout) {
                dispatchEvent(TCPSocketEventType.REFRESH_TIMEOUT);

                close(false);
            }
            else {
                __refreshTimeoutCount += elapsed * 1000;
            }
        }

        return;
    }

    private function __updateReceive(elapsed:Float):Bool {
        if(!receiving) {
            if(!__receiveHeader()) {
                return;
            }
        }

        var curBytes = Std.int(Math.min(__socket.bytesAvailable, __receivePayloadByteSize - __curReceivePayloadByteSize));

        if(curBytes <= 0) {
            return;
        }

        __socket.readBytes(__receiveBuffer.payload, __curReceivePayloadByteSize, curBytes);
        __curReceivePayloadByteSize += curBytes;

        __refreshTimeoutCount = 0;

        if(__receivePayloadByteSize - __curReceivePayloadByteSize <= 0) {
            if(!connected) {
                if(__receiveBuffer.payload.toString() != __contract.connectedMessage) {
                    receiving = false;

                    return;
                }

                connected = true;
                dispatchEvent(TCPSocketEventType.CONNECT);

                receiving = false;

                __connectTimeoutCount = 0;

                return;
            }
            else if(__receiveBuffer.payload.toString() == __contract.closeMessage) {
                close();

                return;
            }

            receiving = false;
            dispatchEvent(TCPSocketEventType.DATA);
        }
    }

    private function __receiveHeader():Bool {
        if(__socket.bytesAvailable < __contract.totalHeaderByteSize) {
            return false;
        }

        // header
        for(name in __contract.headerOrderArray.iterator()) {
            var headerInfo = __contract.getHeaderByName(name);

            switch(headerInfo.type) {
                case HeaderType.BYTE:
                    __receiveBuffer.headerMap.set(name, __socket.readUnsignedByte());

                case HeaderType.SHORT:
                    __receiveBuffer.headerMap.set(name, __socket.readUnsignedShort());

                case HeaderType.INT:
                    __receiveBuffer.headerMap.set(name, __socket.readUnsignedInt());

                case HeaderType.VARINT: // sorry for that
                    var bytes:ByteArray = new ByteArray(headerInfo.byteSize);
                    __socket.readBytes(bytes, 0, headerInfo.byteSize);

                    __receiveBuffer.headerMap.set(name, bytes);

                case HeaderType.STRING:
                    __receiveBuffer.headerMap.set(name, __socket.readUTFBytes(headerInfo.byteSize));
            }
        }

        if(__receivePayloadByteSize == 0) {
            return false;
        }

        // payload
        __receiveBuffer.payload = new ByteArray(__receivePayloadByteSize);

        __curReceivePayloadByteSize = 0;
        receiving = true;

        __refreshTimeoutCount = 0;

        return true;
    }

    private function __updateSend(elapsed:Float) {
        if(__sendQueue.length <= 0) {
            return;
        }

        var sendThingie = __sendQueue.pop();

        for(name in __contract.headerOrderArray.iterator()) {
            var headerInfo = __contract.getHeaderByName(name);

            switch(headerInfo.type) {
                case HeaderType.BYTE:
                    __socket.writeByte(sendThingie.headerMap.get(name));

                case HeaderType.SHORT:
                    __socket.writeShort(sendThingie.headerMap.get(name));

                case HeaderType.INT:
                    __socket.writeUnsignedInt(sendThingie.headerMap.get(name));

                case HeaderType.VARINT:
                    var bytes = sendThingie.headerMap.get(name);
                    __socket.writeBytes(bytes, 0, headerInfo.byteSize);

                case HeaderType.STRING:
                    var bytes = new ByteArray(headerInfo.byteSize);
                    bytes.writeUTFBytes(sendThingie.headerMap.get(name));

                    __socket.writeBytes(bytes, 0, headerInfo.byteSize);
            }
        }

        var payloadByteSize = sendThingie.headerMap.get(__contract.payloadByteSizeHeaderName);
        __socket.writeBytes(sendThingie.payload, 0, payloadByteSize);

        __socket.flush();
    }

    public function connect(host:String, port:Int) {
        if(destroyed) {
            throw "socket destroyed";
        }

        connectCalled = true;
        closed = false;
        __socket.connect(host, port);
    }

    public function close(doDispatchEvent:Bool = true) {
        if(destroyed) {
            throw "socket destroyed";
        }

        if(closed) {
            throw "socket closed";
        }

        receiving = false;
        connected = false;
        connectCalled = false;
        closed = true;

        if(doDispatchEvent) {
            dispatchEvent(TCPSocketEventType.CLOSE);
        }

        try {
            __socket.close();
        }
        catch(e:Dynamic) {}
    }

    public function destroy() {
        try {
            close();
        }
        catch(e:Dynamic) {}

        if(destroyed) {
            throw "socket destroyed";
        }

        destroyed = true;

        __socket = null;

        for(key in __events.keys()) {
            var listeners = __events.get(key);
            if(listeners == null) {
                continue;
            }

            for(i in 0...listeners.length) {
                listeners[i] = null;
            }
        }

        __events.clear();
        __events = null;
    }

    public function sendBytes(header:StringMap<Dynamic>, text:String):Bool {
        if(!connected) {
            return false;
        }

        for(name in __contract.headerOrderArray.iterator()) {
            if(!header.exists(name)) {
                throw "wrong header";
            }
        }

        var payload = ByteArray.fromBytes(Bytes.ofString(text));

        var maxPayloadByteSize = switch(__contract.getHeaderByName(__contract.payloadByteSizeHeaderName).type) {
            case HeaderType.BYTE:
                255;

            case HeaderType.SHORT:
                65535;

            case HeaderType.INT:
                -1;
        };
        if(payload.length & maxPayloadByteSize != payload.length) {
            throw "too long payload";
        }

        var copied = header.copy();
        copied.set(__contract.payloadByteSizeHeaderName, payload.length);

        var sendThingie:TCPCustomProtocol = {
            headerMap: copied,
            payload: payload
        };

        __sendQueue.add(sendThingie);

        return true;
    }

    // event line
    public function addEventListener(socketEvent:Int, listener:Dynamic->Void, priority:Int = 10) {
        if(destroyed) {
            throw "socket destroyed";
        }

        var listeners = __events.get(socketEvent);

        listeners.push({
            priority: priority,
            listener: listener
        });

        listeners.sort((a, b) -> {
            return a.priority - b.priority;
        });
    }

    public function dispatchEvent(socketEvent:Int) {
        if(destroyed) {
            throw "socket destroyed";
        }

        var listeners = __events.get(socketEvent);
        if(listeners == null) {
            trace("wh");

            return;
        }

        var socketEventData = switch(socketEvent) {
            case TCPSocketEventType.CONNECT:
                new SocketConnectEvent(
                    __socket.localAddress,
                    __socket.localPort,
                    {
                        remoteAddress: __socket.remoteAddress,
                        remotePort: __socket.remotePort
                    }
                );

            case TCPSocketEventType.DATA:
                new SocketDataEvent(
                    __socket.localAddress,
                    __socket.localPort,
                    {
                        headerMap: new ReadonlyStringMap(__receiveBuffer.headerMap.copy()),
                        headerOrderArray: new ReadonlyArray(__contract.headerOrderArray.copy()),
                        payload: __receiveBuffer.payload
                    }
                );

            case TCPSocketEventType.CLOSE:
                new SocketCloseEvent(
                    __socket.localAddress,
                    __socket.localPort
                );

            case TCPSocketEventType.CONNECT_TIMEOUT, TCPSocketEventType.REFRESH_TIMEOUT:
                new SocketTimeoutEvent(
                    __socket.localAddress,
                    __socket.localPort
                );
        }

        for(curListener in listeners) {
            if(!socketEventData.shouldPropagate) {
                break;
            }

            if(curListener == null) {
                continue;
            }

            curListener.listener(socketEventData);
        }
    }

    public function removeEventListener(socketEvent:Int, listener:Dynamic->Void):Bool {
        if(destroyed) {
            throw "socket destroyed";
        }

        var listeners = __events.get(socketEvent);
        var removed = false;

        for(i in 0...listeners.length) {
            var curListener = listeners[i];
            if(curListener == null) {
                continue;
            }

            if(curListener.listener == listener) {
                listeners.splice(i, 1);

                removed = true;

                break;
            }
        }

        return removed;
    }

    public function willTrigger(socketEvent:Int):Bool {
        if(destroyed) {
            throw "socket destroyed";
        }

        return __events.get(socketEvent).length > 0;
    }
}

typedef _SocketEventListener = {
    var priority:Int;
    var listener:Dynamic->Void;
}
